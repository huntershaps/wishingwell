# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local database and uploaded media (kept out of the source scan as well as git —
# Tailwind walks the project and SQLite keeps a lock on its WAL sidecar files)
/.data
/public/uploads

# The demo photography and the video notes made from it. Reproducible with
# `npm run media` — the manifest pins every photo by id — so 15MB of other
# people's photographs does not need to live in this repository.
/public/media
