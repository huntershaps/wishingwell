# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local database and uploaded media (kept out of the source scan as well as git —
# Tailwind walks the project and SQLite keeps a lock on its WAL sidecar files)
/.data
/public/uploads

# The demo photography and the video notes made from it used to be left out and
# regenerated with `npm run media`. They are committed now: the deployed image is
# built in the cloud from this repository, and both the seed and the demo itself
# need the photographs to exist at build time. Fetching them mid-build would put
# the deploy at the mercy of a third party's rate limiter. Credit for every photo
# is in public/media/credits.json.
